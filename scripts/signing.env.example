# Copy to scripts/signing.env (gitignored) and fill in.
# Your Apple Developer team ID (10 characters, shown in your developer account).
TEAM_ID=
# Optional: force a specific identity instead (name or SHA-1, "-" for ad-hoc).
# SIGN_IDENTITY=
# Optional: notarytool keychain profile, used with a Developer ID certificate.
# NOTARY_PROFILE=
